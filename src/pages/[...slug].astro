
---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentSections from '../components/ContentSections.astro';
import ContactForm from '../components/ContactForm.astro';
import data from '../data/website.json';

export function getStaticPaths() {
  return data.pages
    .filter(page => page.path !== '/' && page.path !== '/expertise' && !page.path.startsWith('/einblicke'))
    .map(page => ({
      params: { slug: page.path.slice(1) },
      props: { page }
    }));
}

const { page } = Astro.props;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  path={page.path}
>
  <div class="hero">
    <div class="wrap">
      <span class="eyebrow">Schäpper Consulting</span>
      <h1>{page.title}</h1>
      <p>{page.intro}</p>
    </div>
  </div>

  <ContentSections sections={page.sections} />

  {page.id === 'contact' && (
    <>
      <ContactForm />
    </>
  )}
</BaseLayout>
